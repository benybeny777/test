{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoVTuber",
  "version": "0.1.0",
  "identifier": "com.picovtuber.desktop",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "PicoVTuber",
        "width": 900,
        "height": 640,
        "minWidth": 320,
        "minHeight": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/models/**", "$APPDATA/jobs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bundled/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
