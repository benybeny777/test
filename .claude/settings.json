{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(cargo *)", "Bash(rustc *)",
      "Bash(python3 *)", "Bash(uv *)",
      "Bash(git *)", "Bash(cygpath *)", "Bash(taskkill *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
